# Interactive diagnosis function
def interactive_diagnosis():
    """
    Interactive command-line tool for diagnosing based on symptoms
    """
    print("\n=== Disease Diagnosis Tool ===")
    print("Enter symptoms you are experiencing (1 for yes, 0 for no, or press Enter to skip)")
    
    # Get the most common symptoms to ask about
    common_symptoms = sorted(X.columns, key=lambda col: X[col].sum(), reverse=True)[:15]
    
    symptoms_dict = {}
    for symptom in common_symptoms:
        response = input(f"Do you have {symptom.replace('_', ' ')}? (1/0/Enter): ").strip()
        if response == '1':
            symptoms_dict[symptom] = 1
        elif response == '0':
            symptoms_dict[symptom] = 0
    
    print("\nBased on your symptoms, the most likely diagnoses are:")
    top_diagnoses = diagnose_patient(symptoms_dict)
    for disease, prob in top_diagnoses:
        print(f"{disease}: {prob:.4f}")
    
    # Ask if they want to see the most indicative symptoms for the top disease
    top_disease = top_diagnoses[0][0]
    response = input(f"\nWould you like to see the key symptoms for {top_disease}? (y/n): ")
    if response.lower() == 'y':
        print(f"\nMost indicative symptoms for {top_disease}:")
        key_symptoms = important_symptoms_for_disease(top_disease)
        for symptom, importance in key_symptoms.items():
            print(f"{symptom.replace('_', ' ')}: {importance:.4f}")


def main():
    """
    Main function to run the disease diagnosis tool
    """
    print("Welcome to the Disease Diagnosis Tool!")
    
    interactive_diagnosis()
    
    plot_confusion_matrix()

    plot_diagnosis(fungal_symptoms)

if __name__ == "__main__":
    main()